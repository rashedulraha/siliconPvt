# ============================================================
#  ESTATEHUB ENVIRONMENT VARIABLES
# ============================================================

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://estatehub.com
NEXT_PUBLIC_SITE_NAME=EstateHub

# CMS Storage
NEXT_PUBLIC_CMS_STORAGE_KEY=estatehub_cms_data

# Analytics (Google Analytics 4)
NEXT_PUBLIC_GA_ID=

# WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=+15551234567

# Contact (optional — falls back to CMS)
NEXT_PUBLIC_CONTACT_EMAIL=hello@estatehub.com
NEXT_PUBLIC_CONTACT_PHONE=+1 (555) 123-4567

# Social Media (optional — falls back to CMS)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Map Integration (optional — uses OpenStreetMap by default)
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
NEXT_PUBLIC_MAPBOX_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_WHATSAPP=true
NEXT_PUBLIC_ENABLE_COOKIE_CONSENT=true

# Development
NODE_ENV=development