model Project {
  id            String   @id @default(cuid())
  num           String?
  title         String
  titleBn       String?
  slug          String?  @unique
  type          String   @default("Township Project") // e.g. "Ongoing Flagship Township"
  typeBn        String?
  status        String   @default("Ongoing") // Ongoing, Upcoming, Completed
  statusBn      String?
  location      String
  locationBn    String?
  description   String
  descriptionBn String?
  images        String[]
  highlights    String[] // tech stack / feature tags
  highlightsBn  String[]
  demoUrl       String?  // live/demo URL or detail link
  clientInfo    String?  // client details / developer info
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

