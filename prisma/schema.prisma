generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id            String   @id @default(cuid())
  title         String
  titleBn       String?
  slug          String   @unique
  type          String   // plot, flat, commercial, project
  category      String   // residential, commercial, industrial, luxury
  status        String   @default("available") // available, booked, sold, rented
  price         Float
  location      String
  locationBn    String?
  areaSqFt      Float?
  bedrooms      Int?
  bathrooms     Int?
  description   String
  descriptionBn String?
  features      String[]
  featuresBn    String[]
  images        String[]
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  message    String
  propertyId String?
  status     String   @default("new") // new, contacted, qualified, closed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Slide {
  id         String   @id @default(cuid())
  title      String
  titleBn    String?
  subtitle   String
  subtitleBn String?
  image      String
  badge      String?
  badgeBn    String?
  link       String?
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("global")
  email          String
  phone          String
  hotline        String?
  address        String
  addressBn      String?
  facebookUrl    String?
  youtubeUrl     String?
  aboutSummary   String?
  aboutSummaryBn String?
  mission        String?
  missionBn      String?
  vision         String?
  visionBn       String?
  socialLinks    String?  // JSON stringified optional social links
  updatedAt      DateTime @updatedAt
}

model ContactInfo {
  id                String   @id @default("global")
  heroTitle         String   @default("Get in Touch with Us")
  heroTitleBn       String?  @default("আমাদের প্রপার্টি ও আইনি পরামর্শক দলের সাথে যোগাযোগ করুন")
  heroDescription   String   @default("Have questions about our residential plots in Silicon City? Want to schedule a physical site visit or discuss membership guidelines? Reach out to our corporate help desk. We are here to help you secure your dream address.")
  heroDescriptionBn String?  @default("সিলিকন সিটিতে প্লট বরাদ্দ, ফ্রি গাড়িতে সাইট পরিদর্শন অথবা সিএস, এসএ, আরএস, বিএস দলিলপত্র যাচাই করতে আমাদের মোহাম্মদপুর কর্পোরেট ডেস্কে যোগাযোগ করুন।")
  address           String   @default("2/3 (2nd Floor), Block # A, Iqbal Road, Mohammadpur, Dhaka-1207, Bangladesh")
  addressBn         String?  @default("২/৩ (২য় তলা), ব্লক-এ, ইকবাল রোড, মোহাম্মদপুর, ঢাকা-১২০৭ (মোহাম্মদপুর টাউন হলের নিকট)")
  phone             String   @default("+880 12 345 678, +880 1234 567 890")
  whatsapp          String   @default("+880 12 345 678")
  email             String   @default("info@siliconrealestatepvtltd.com")
  secondaryEmail    String?  @default("siliconrealestate@gmail.com")
  website           String   @default("siliconrealestatepvtltd.com")
  businessHours     String   @default("Saturday - Thursday: 9:00 AM – 5:00 PM | Friday: Closed")
  businessHoursBn   String?  @default("শনিবার – বৃহস্পতিবার: সকাল ৯:০০ – বিকাল ৫:০০ | শুক্রবার: বন্ধ")
  mapEmbedUrl       String   @default("https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3651.8973685412356!2d90.3621!3d23.7509!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755bf4f483c6d7d%3A0x6b4f74d6c6e18f2f!2sIqbal%20Rd%2C%20Dhaka%201207!5e0!3m2!1sen!2sbd!4v1700000000000!5m2!1sen!2sbd")
  siteVisitNotice   String   @default("Silicon City is strategically located in Bara Badeshi Mouza, Savar, right next to the Turag River and adjacent to Mohammadpur Beribadh. We arrange physical site guided tours for our clients directly from our Corporate Office.")
  siteVisitNoticeBn String?  @default("সিলিকন সিটি সাভারের বড় বাদেশী মৌজায় তুরাগ নদীর তীরে ও মোহাম্মদপুর বেড়িবাঁধ সংলগ্ন এলাকায় অবস্থিত। আমাদের কর্পোরেট অফিস থেকে নিয়মিত নিজস্ব পরিবহনে সাইট ভিজিট পরিচালনা করা হয়।")
  imageUrl          String?  
  facebookUrl       String?  @default("https://facebook.com")
  youtubeUrl        String?  @default("https://youtube.com")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MembershipContent {
  id                  String   @id @default("global")
  heroTitle           String   @default("Silicon City Membership Guidelines")
  heroTitleBn         String?  @default("সিলিকন সিটি মেম্বারশিপ ও বুকিং নির্দেশিকা")
  heroDescription     String   @default("Review our official offline membership process, download the printable application form, and understand the terms and conditions required to secure your plot ownership in Silicon City.")
  heroDescriptionBn   String?  @default("অফিসিয়াল মেম্বারশিপ আবেদন প্রক্রিয়া পর্যালোচনা করুন, আবেদন ফরম ডাউনলোড করুন এবং সিলিকন সিটিতে প্লট বরাদ্দ নিশ্চিত করতে শর্তাবলী জানুন।")
  formPdfUrl          String   @default("/assets/silicon-membership-form.pdf")
  applicationFee      String   @default("BDT 1,000")
  landSharePercentage String   @default("25% - 30%")
  soilElevationHeight String   @default("16 to 18 Feet")
  offlineNoticeText   String   @default("Download the printable PDF application form, attach your NID copies and photographs, and submit it at our Mohammadpur Corporate Office with the BDT 1,000 application fee.")
  offlineNoticeTextBn String?  @default("প্রিন্টযোগ্য আবেদন ফরমটি ডাউনলোড করে এনআইডি কপি ও ছবি সংযুক্ত করুন এবং মোহাম্মদপুর অফিসে জমা দিন।")
  contactHotline      String   @default("+880 12 345 678 / +880 1712 345 678")
  pathways            String?  // JSON stringified array of pathways
  termsAndConditions  String?  // JSON stringified array of terms
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  titleBn     String?
  slug        String   @unique
  excerpt     String
  excerptBn   String?
  content     String
  contentBn   String?
  image       String
  category    String   @default("Company News")
  author      String   @default("Silicon Editorial")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  titleBn   String?
  category  String   // project | infrastructure | office | handovers
  badge     String
  location  String
  overview  String
  overviewBn String?
  images    String[]
  features  String[]
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  role      String   // Chairman, Managing Director, Executive, etc.
  roleBn    String?
  speech    String   // Formal leadership address speech
  speechBn  String?
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  num           String?
  title         String
  titleBn       String?
  tag           String
  tagBn         String?
  description   String
  descriptionBn String?
  icon          String?
  imageUrl      String?
  pricing       String?
  benefits      String[]
  benefitsBn    String[]
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutContent {
  id              String   @id @default(cuid())
  heroTitle       String
  heroTitleBn     String?
  heroSubtitle    String
  heroSubtitleBn  String?
  heroDesc        String
  heroDescBn      String?
  whoWeAreTitle   String
  whoWeAreTitleBn String?
  whoWeAreDesc    String
  whoWeAreDescBn  String?
  missionTitle    String
  missionTitleBn  String?
  missionDesc     String
  missionDescBn   String?
  visionTitle     String
  visionTitleBn   String?
  visionDesc      String
  visionDescBn    String?
  chairmanName    String
  chairmanNameBn  String?
  chairmanRole    String
  chairmanRoleBn  String?
  chairmanSpeech  String
  chairmanSpeechBn String?
  chairmanImage   String
  mdName          String
  mdNameBn        String?
  mdRole          String
  mdRoleBn        String?
  mdSpeech        String
  mdSpeechBn      String?
  mdImage         String
  stats           Json?
  statsBn         Json?
