generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id            String   @id @default(cuid())
  title         String
  titleBn       String?
  slug          String   @unique
  type          String   // plot, flat, commercial, project
  category      String   // residential, commercial, industrial, luxury
  status        String   @default("available") // available, booked, sold, rented
  price         Float
  location      String
  locationBn    String?
  areaSqFt      Float?
  bedrooms      Int?
  bathrooms     Int?
  description   String
  descriptionBn String?
  features      String[]
  featuresBn    String[]
  images        String[]
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  message    String
  propertyId String?
  status     String   @default("new") // new, contacted, qualified, closed
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Slide {
  id         String   @id @default(cuid())
  title      String
  titleBn    String?
  subtitle   String
  subtitleBn String?
  image      String
  badge      String?
  badgeBn    String?
  link       String?
  active     Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("global")
  email          String
  phone          String
  hotline        String?
  address        String
  addressBn      String?
  facebookUrl    String?
  youtubeUrl     String?
  aboutSummary   String?
  aboutSummaryBn String?
  mission        String?
  missionBn      String?
  vision         String?
  visionBn       String?
  socialLinks    String?  // JSON stringified optional social links
  updatedAt      DateTime @updatedAt
}

model ContactInfo {
  id                String   @id @default("global")
  heroTitle         String?
  heroTitleBn       String?
  heroDescription   String?
  heroDescriptionBn String?
  address           String?
  addressBn         String?
  phone             String?
  whatsapp          String?
  email             String?
  secondaryEmail    String?
  website           String?
  businessHours     String?
  businessHoursBn   String?
  mapEmbedUrl       String?
  siteVisitNotice   String?
  siteVisitNoticeBn String?
  imageUrl          String?  
  facebookUrl       String?
  youtubeUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MembershipContent {
  id                  String   @id @default("global")
  heroTitle           String?
  heroTitleBn         String?
  heroDescription     String?
  heroDescriptionBn   String?
  formPdfUrl          String?
  applicationFee      String?
  landSharePercentage String?
  soilElevationHeight String?
  offlineNoticeText   String?
  offlineNoticeTextBn String?
  contactHotline      String?
  pathways            String?  // JSON stringified array of pathways
  termsAndConditions  String?  // JSON stringified array of terms
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  titleBn     String?
  slug        String   @unique
  excerpt     String
  excerptBn   String?
  content     String
  contentBn   String?
  image       String
  category    String
  author      String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  titleBn   String?
  category  String   // project | infrastructure | office | handovers
  badge     String
  location  String
  overview  String
  overviewBn String?
  images    String[]
  features  String[]
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  nameBn    String?
  role      String   // Chairman, Managing Director, Executive, etc.
  roleBn    String?
  speech    String   // Formal leadership address speech
  speechBn  String?
  image     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id            String   @id @default(cuid())
  num           String?
  title         String
  titleBn       String?
  tag           String
  tagBn         String?
  description   String
  descriptionBn String?
  icon          String?
  imageUrl      String?
  pricing       String?
  benefits      String[]
  benefitsBn    String[]
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AboutContent {
  id              String   @id @default(cuid())
  heroTitle       String
  heroTitleBn     String?
  heroSubtitle    String
  heroSubtitleBn  String?
  heroDesc        String
  heroDescBn      String?
  whoWeAreTitle   String
  whoWeAreTitleBn String?
  whoWeAreDesc    String
  whoWeAreDescBn  String?
  missionTitle    String
  missionTitleBn  String?
  missionDesc     String
  missionDescBn   String?
  visionTitle     String
  visionTitleBn   String?
  visionDesc      String
  visionDescBn    String?
  chairmanName    String
  chairmanNameBn  String?
  chairmanRole    String
  chairmanRoleBn  String?
  chairmanSpeech  String
  chairmanSpeechBn String?
  chairmanImage   String
  mdName          String
  mdNameBn        String?
  mdRole          String
  mdRoleBn        String?
  mdSpeech        String
  mdSpeechBn      String?
  mdImage         String
  stats           Json?
  statsBn         Json?
  coreValues      Json?
  coreValuesBn    Json?
  timeline        Json?
  timelineBn      Json?
  whyChooseUs     Json?
  whyChooseUsBn   Json?
  managementTeam  Json?
  managementTeamBn Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HomeContent {
  id                 String   @id @default(cuid())
  heroBadge          String
  heroBadgeBn        String?
  heroTitle          String
  heroTitleBn        String?
  heroSubtitle       String
  heroSubtitleBn     String?
  heroDesc           String
  heroDescBn         String?
  heroCtaText        String
  heroCtaTextBn      String?
  heroCtaLink        String
  masterPlanBadge    String?
  masterPlanBadgeBn  String?
  masterPlanTitle    String?
  masterPlanTitleBn  String?
  masterPlanDesc     String?
  masterPlanDescBn   String?
  masterPlanImage    String?
  amenitiesBadge     String?
  amenitiesBadgeBn   String?
  amenitiesTitle     String?
  amenitiesTitleBn   String?
  amenitiesDesc      String?
  amenitiesDescBn    String?
  showcaseBadge      String?
  showcaseBadgeBn    String?
  showcaseTitle      String?
  showcaseTitleBn    String?
  showcaseDesc       String?
  showcaseDescBn     String?
  trackRecordTitle   String
  trackRecordTitleBn String?
  trackRecordDesc    String
  trackRecordDescBn  String?
  trustCounters      Json?
  trustCountersBn    Json?
  accreditations     Json?
  accreditationsBn   Json?
  ctaTitle           String
  ctaTitleBn         String?
  ctaDesc            String
  ctaDescBn          String?
  ctaButtonText      String
  ctaButtonTextBn    String?
  ctaButtonLink      String
  sectionsConfig     Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  num           String?
  title         String
  titleBn       String?
  slug          String?  @unique
  type          String?  // e.g. "Ongoing Flagship Township"
  typeBn        String?
  status        String   @default("Ongoing") // Ongoing, Upcoming, Completed
  statusBn      String?
  location      String
  locationBn    String?
  description   String
  descriptionBn String?
  images        String[]
  highlights    String[] // tech stack / feature tags
  highlightsBn  String[]
  demoUrl       String?  // live/demo URL or detail link
  clientInfo    String?  // client details / developer info
  order         Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ProjectsContent {
  id                String   @id @default(cuid())
  heroTitle         String?
  heroTitleBn       String?
  heroSubtitle      String?
  heroSubtitleBn    String?
  heroDesc          String?
  heroDescBn        String?
  trustMetrics      Json?
  trustMetricsBn    Json?
  spotlightBadge    String?
  spotlightBadgeBn  String?
  spotlightTitle    String?
  spotlightTitleBn  String?
  spotlightDesc     String?
  spotlightDescBn   String?
  spotlightTag      String?
  spotlightTagBn    String?
  spotlightBoxTitle String?
  spotlightBoxTitleBn String?
  spotlightBoxDesc  String?
  spotlightBoxDescBn String?
  spotlightLocation String?
  spotlightLocationBn String?
  spotlightBadge2   String?
  spotlightBadge2Bn String?
  specs             Json?
  specsBn           Json?
  categories        Json?
  categoriesBn      Json?
  amenities         Json?
  amenitiesBn       Json?
  proximities       Json?
  proximitiesBn     Json?
  roadmap           Json?
  roadmapBn         Json?
  ctaBadge          String?
  ctaBadgeBn        String?
  ctaTitle          String?
  ctaTitleBn        String?
  ctaDesc           String?
  ctaDescBn         String?
  ctaHotline        String?
  ctaEmail          String?
  ctaOffice         String?
  ctaOfficeBn       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
